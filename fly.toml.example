app = "__FLY_APP_NAME__"
primary_region = "sea"

[build]
  dockerfile = "Dockerfile"

[env]
  MYTODO_LISTEN_ADDR = "0.0.0.0:8080"
  MYTODO_DATA_DIR = "/data"
  MYTODO_WEB_DIR = "/app/web"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 1

[[mounts]]
  source = "mytodo_data"
  destination = "/data"

[[http_service.checks]]
  method = "GET"
  path = "/healthz"
  interval = "30s"
  timeout = "5s"