{
  "modules": [
    {
      "name": "voting",
      "package": "voting",
      "label": "Event",
      "master": {
        "name": "voting_event",
        "label": "Event",
        "fields": [
          { "name": "title", "label": "Title", "type": "text", "required": true },
          { "name": "description", "label": "Description", "type": "text" },
          { "name": "event_type", "label": "Event type", "type": "text", "required": true, "options": ["Vote", "Internal", "External", "Personal"] },
          { "name": "opens_at", "label": "Opens", "type": "datetime", "required": true, "range_min": "06:00", "range_max": "22:00" },
          { "name": "closes_at", "label": "Closes", "type": "datetime", "required": true }
        ]
      },
      "detail": {
        "name": "vote",
        "label": "Vote",
        "fields": [
          { "name": "voter_user_id", "label": "Voter", "type": "int64", "required": true },
          { "name": "choice", "label": "Choice", "type": "text", "required": true, "options": ["Yes", "No", "Abstain"] },
          { "name": "comments", "label": "Comments", "type": "text" }
        ],
        "unique": ["voter_user_id"],
        "validation_rules": [
          { "when": { "choice": "Abstain" }, "required": ["comments"] }
        ]
      }
    }

  ],
  "tables": [
    {
      "name": "era",
      "fields": [
        { "name": "slug", "type": "text", "required": true },
        { "name": "title", "type": "text", "required": true },
        { "name": "sort_order", "type": "int64", "required": true },
        { "name": "theme_json", "type": "text", "required": true }
      ],
      "unique": ["slug"]
    },
    {
      "name": "album",
      "fields": [
        { "name": "era_id", "type": "int64", "required": true },
        { "name": "title", "type": "text", "required": true },
        { "name": "sort_order", "type": "int64", "required": true }
      ],
      "foreign_keys": [
        { "field": "era_id", "references": "era.id", "on_delete": "CASCADE" }
      ]
    },
    {
      "name": "media",
      "fields": [
        { "name": "album_id", "type": "int64", "required": true },
        { "name": "kind", "type": "text", "required": true, "options": ["photo", "short"] },
        { "name": "content_hash", "type": "text", "required": true },
        { "name": "duration_s", "type": "int64" },
        { "name": "caption", "type": "text" },
        { "name": "sort_order", "type": "int64", "required": true }
      ],
      "unique": ["content_hash"],
      "foreign_keys": [
        { "field": "album_id", "references": "album.id", "on_delete": "CASCADE" }
      ]
    },
    {
      "name": "comment",
      "fields": [
        { "name": "media_id", "type": "int64", "required": true },
        { "name": "user_id", "type": "int64", "required": true },
        { "name": "body", "type": "text", "required": true },
        { "name": "created_at", "type": "text", "required": true }
      ],
      "foreign_keys": [
        { "field": "media_id", "references": "media.id", "on_delete": "CASCADE" },
        { "field": "user_id", "references": "users.id", "on_delete": "CASCADE" }
      ]
    },
    {
      "name": "layout_frame",
      "fields": [
        { "name": "region", "type": "text", "required": true, "options": ["top", "bottom", "left", "right", "center"] },
        { "name": "feature", "type": "text", "required": true },
        { "name": "visible", "type": "bool", "required": true },
        { "name": "config_json", "type": "text", "required": true }
      ],
      "unique": ["region"]
    }
  ],
  "types": [
    {
      "type_key": "manager",
      "type_id": 101,
      "parent_type_id": null,
      "header": {
        "ndc_1": "Name",
        "ndc_2": "Email",
        "ndc_3": "Department"
      },
      "logic_rule": {
        "validation": "fnValidateManager"
      },
      "ui": {
        "list_cols": ["ndc_1", "ndc_2"],
        "form_order": ["ndc_1", "ndc_2", "ndc_3"]
      }
    },
    {
      "type_key": "staff",
      "type_id": 102,
      "parent_type_id": 101,
      "header": {
        "ndc_1": "Name",
        "ndc_2": "Email",
        "ndc_3": "Designation"
      },
      "logic_rule": {
        "validation": "fnValidateStaff"
      },
      "ui": {
        "list_cols": ["ndc_1", "ndc_2"],
        "form_order": ["ndc_1", "ndc_2", "ndc_3"]
      }
    }
  ]
}