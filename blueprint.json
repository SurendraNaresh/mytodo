{
  "modules": [
    {
      "name": "voting",
      "package": "voting",
      "label": "Event",
      "master": {
        "name": "voting_event",
        "label": "Event",
        "fields": [
          { "name": "title", "label": "Title", "type": "text", "required": true },
          { "name": "description", "label": "Description", "type": "text" },
          { "name": "event_type", "label": "Event type", "type": "text", "required": true, "options": ["Vote", "Internal", "External", "Personal"] },
          { "name": "opens_at", "label": "Opens", "type": "datetime", "required": true, "range_min": "06:00", "range_max": "22:00" },
          { "name": "closes_at", "label": "Closes", "type": "datetime", "required": true }
        ]
      },
      "detail": {
        "name": "vote",
        "label": "Vote",
        "fields": [
          { "name": "voter_user_id", "label": "Voter", "type": "int64", "required": true },
          { "name": "choice", "label": "Choice", "type": "text", "required": true, "options": ["Yes", "No", "Abstain"] },
          { "name": "comments", "label": "Comments", "type": "text" }
        ],
        "unique": ["voter_user_id"],
        "validation_rules": [
          { "when": { "choice": "Abstain" }, "required": ["comments"] }
        ]
      }
    }

  ],
  "types": [
    {
      "type_key": "manager",
      "type_id": 101,
      "parent_type_id": null,
      "header": {
        "ndc_1": "Name",
        "ndc_2": "Email",
        "ndc_3": "Department"
      },
      "logic_rule": {
        "validation": "fnValidateManager"
      },
      "ui": {
        "list_cols": ["ndc_1", "ndc_2"],
        "form_order": ["ndc_1", "ndc_2", "ndc_3"]
      }
    },
    {
      "type_key": "staff",
      "type_id": 102,
      "parent_type_id": 101,
      "header": {
        "ndc_1": "Name",
        "ndc_2": "Email",
        "ndc_3": "Designation"
      },
      "logic_rule": {
        "validation": "fnValidateStaff"
      },
      "ui": {
        "list_cols": ["ndc_1", "ndc_2"],
        "form_order": ["ndc_1", "ndc_2", "ndc_3"]
      }
    }
  ]
}